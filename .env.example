# Which implementation to use. "temp" = TempMainLLM / TempEmbed.
LLM_PROVIDER=temp
EMBED_PROVIDER=temp

# Local embedding model used by TempEmbed (downloaded on first use).
EMBED_MODEL=intfloat/multilingual-e5-small

# Where uploads and the index are stored (relative to the project root).
DATA_DIR=data
MAX_UPLOAD_MB=20

# Put API keys here once you have them, e.g.
# OPENAI_API_KEY=sk-...
